# Backend Environment Variables (.env)
# --------------------------------------------------
# Server Port
PORT=3000

# Environment Mode: development | production
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/skyway?retryWrites=true&w=majority

# JWT Token Secrets (Use strong random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here_32chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_32chars

# Token Expiry Durations
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Cookie Secret
COOKIE_SECRET=your_cookie_secret_key_here

# Allowed Frontend URL (CORS origin)
# For local dev: http://localhost:5173
# For Vercel production: https://<your-vercel-app-name>.vercel.app
CLIENT_URL=http://localhost:5173

# Admin Initial Credentials for Database Seeder (npm run seed)
ADMIN_EMAIL=admin@skyway.com
ADMIN_PASSWORD=Admin@123456
